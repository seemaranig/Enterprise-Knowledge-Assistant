# Frontend Environment Configuration

# Backend API Settings
API_URL=http://localhost:8000
API_TIMEOUT=120
MAX_RETRIES=3
RETRY_DELAY=1

# File Upload Settings
MAX_UPLOAD_SIZE_MB=50

# UI Settings
THEME=light

# Query Settings (internal)
# MIN_QUERY_LENGTH=1 (default 1)
# MAX_QUERY_LENGTH=1000 (default 1000)

# Feature Flags
SHOW_ADVANCED_OPTIONS=False
ENABLE_CHAT_HISTORY=True
ENABLE_FEEDBACK=False

# Security
ENABLE_HTTPS=False

# Logging
LOG_LEVEL=INFO
